# Для Docker используйте имя сервиса: postgres. Для локальной разработки: localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lyceum_auth
ALLOWED_ORIGINS=["http://localost:8000"]

ENV_FILE_PATH=.env
ROOT_PATH=/

ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Host names are supplied to Compose; the backend itself is reachable at API_DOMAIN.
DOMAIN=example.test
API_DOMAIN=api.users.example.test
# Traefik TLS resolver: selfsigned или letsencrypt
TLS_RESOLVER=letsencrypt # selfsigned

INTERNAL_AUTHENTIK_URL=http://localhost:9000
SA_AUTH_ADMIN_APP_API_TOKEN=
ALLOWED_APPLICATION_SLUGS=["spravki-app","technical-support-app","auth-admin-app"]
USERS_PATH=users
